# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cybershield_lms

# JWT
JWT_SECRET=your-secret-key-here-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars
JWT_EXPIRES_IN=1h

# Azure SSO (Microsoft Entra ID)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Email / SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notifications@company.com
SMTP_PASS=your-smtp-password

# Frontend
FRONTEND_URL=http://localhost:3000

# Session
SESSION_SECRET=your-session-secret-min-32-chars-long

# File Uploads
MAX_UPLOAD_SIZE=10mb

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!
